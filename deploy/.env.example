# Copy to deploy/.env (chmod 600). Never commit the real file.
# This machine's Tailscale name, e.g. biscotti.tailXXXX.ts.net
TAILNET_HOST=
AI_GATEWAY_API_KEY=
# Web search (https://dashboard.exa.ai/api-keys)
EXA_API_KEY=
# From the Photon dashboard
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The only sender the agent answers, as Photon reports it, e.g. +15551234567
OWNER=
TZ=America/New_York
# Your email: your login for Executor's admin account and your vault invite
OWNER_EMAIL=
# Generated by install.sh: Executor's admin password (you sign in with OWNER_EMAIL and this)
EXECUTOR_ADMIN_PASSWORD=
# Optional: set only for an Executor that was already set up by hand; otherwise the agent mints its own token
EXECUTOR_API_KEY=
# The agent's own Vaultwarden account, registered on first start (install.sh generates it)
VAULT_PASSWORD=
# Set to false after creating your Vaultwarden account
VAULTWARDEN_SIGNUPS=true
