#cloud-config
hostname: biscotti
ssh_pwauth: false
users:
  - name: lucas
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ssh-ed25519 AAAA...your-public-key
package_update: true
packages: [curl, git, avahi-daemon]
runcmd:
  - curl -fsSL https://tailscale.com/install.sh | sh
  - |
    KEY=REPLACE_WITH_TAILSCALE_AUTH_KEY
    case "$KEY" in REPLACE_*) ;; *) tailscale up --hostname=biscotti --authkey="$KEY" ;; esac
