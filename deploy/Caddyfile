# The sandbox bridge: a plain router for task VMs; it holds no keys.
{
	admin localhost:2019
}

# Pages the agent publishes, from its data volume; Tailscale Funnel makes them public on 443 (unguessable names).
http://:8082 {
	bind 127.0.0.1
	root * /agent/pages
	file_server
}

# Each task VM slot reaches this as 172.16.0.1; its namespace forwards to the slot's host address.
http://:80 {
	bind 10.200.1.1 10.200.2.1 10.200.3.1

	# The model (/llm), web search (/search) and connectors (/tools): all through the agent's gate, which holds the
	# keys and asks the owner before writes.
	@gate path /llm/* /search/* /tools/*
	handle @gate {
		reverse_proxy 127.0.0.1:4790
	}

	respond 404
}
