# The sandbox bridge: task VMs reach the model and the owner's connectors through here without holding any keys.
{
	admin localhost:2019
}

# Pages the agent publishes, from its data volume; Tailscale Serve exposes them on the tailnet (:8445).
http://:8082 {
	bind 127.0.0.1
	root * /agent/pages
	file_server
}

# Each task VM slot reaches this as 172.16.0.1; its namespace forwards to the slot's host address.
http://:80 {
	bind 10.200.1.1 10.200.2.1 10.200.3.1

	handle_path /llm/* {
		reverse_proxy https://ai-gateway.vercel.sh {
			header_up Authorization "Bearer {env.AI_GATEWAY_API_KEY}"
			header_up -x-api-key
			header_up Host {upstream_hostport}
		}
	}

	# Web search: Exa's MCP server.
	handle_path /search/* {
		reverse_proxy https://mcp.exa.ai {
			header_up x-api-key "{env.EXA_API_KEY}"
			header_up Host {upstream_hostport}
		}
	}

	# Connectors: the agent's pass-through to Executor, which asks the owner before any write.
	handle_path /tools/* {
		reverse_proxy 127.0.0.1:4790
	}

	respond 404
}
