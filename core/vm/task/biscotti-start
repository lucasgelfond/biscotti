#!/bin/sh
# Starts the task desktop (after biscotti-init in the VM, or as the image's command): Chromium open and maximized once X
# is up, for the browser tools to drive over CDP; the task agent on port 4000 (goal in, JSON events out); then Cua's
# desktop. everydaybench.test (the benchmark's sites, a reserved name nothing real uses) is the VM's gateway, where the
# bench forwards it to EverydayBench.
install -d -o cua -g cua -m 0700 /run/cua
(until xdpyinfo -display :1 >/dev/null 2>&1; do sleep 0.2; done; runuser -u cua -- chromium --remote-debugging-port=9222 \
  --user-data-dir=/tmp/chromium --no-first-run --no-default-browser-check --disable-dev-shm-usage --start-maximized \
  --password-store=basic --host-resolver-rules="MAP *.everydaybench.test 172.16.0.1" about:blank) &
# DevTools for the host (Chromium only listens on loopback), so the vault can type into pages.
socat TCP-LISTEN:9223,fork,reuseaddr TCP:127.0.0.1:9222 &
runuser -u cua -- env HOME=/home/cua /usr/local/bin/biscotti-task &
exec /usr/bin/supervisord -c /etc/supervisor/supervisord.conf
