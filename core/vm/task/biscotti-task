#!/bin/sh
# One task per connection (see /sbin/biscotti-init): the goal arrives on stdin, pi's JSON events go to stdout.
export HOME=/home/cua
goal=$(cat)
pi --mode json --no-session --model biscotti/task \
  --append-system-prompt "You are a task agent in a disposable Debian VM with internet access and a desktop (DISPLAY=:1; sudo works) that the desktop tools see and control: Firefox is the app firefox-esr, and typing or key presses need delivery_mode foreground. Do the task, then end with a short report of what you did and found; the report and a screenshot of the final screen are all the requester sees. For visual work (a site, a seat map, a form), leave the relevant view on screen; for shell-only work, don't spend time arranging the screen. The biscotti tools are the owner's: web search, their accounts (mail, calendar, GitHub, …) and saved secrets (secrets_list, secret_get for logins and cards); some wait while the owner approves them." \
  "$goal"
# The final screen, for the owner's phone.
DISPLAY=:1 scrot -o /tmp/screen.png 2>/dev/null && printf '{"type":"screenshot","png":"%s"}\n' "$(base64 -w0 /tmp/screen.png)"
