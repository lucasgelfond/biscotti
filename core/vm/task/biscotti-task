#!/usr/bin/env node
// The VM's setup, on port 4000, for the host (core/src/plugin.ts's prepareVm): a key authorized for ssh (the gate's, for
// pi-env, or the owner's), a repo checked out, a setup command run; each optional. It answers with the VM's host key.
// A task's work runs in the main agent, its tools here through pi-env over that ssh (core/src/agent-tasks.ts).
import { execFileSync, spawn } from "node:child_process";
import { existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { once } from "node:events";
import { createServer } from "node:net";
import { createInterface } from "node:readline";

const HOME = "/home/cua";
// A coding task's repo arrives as a git bundle: checked out in ~/repo with no remote (nothing in the VM can push), with
// jj alongside git (colocated); its commits go back the same way, through pi-env.
const REPO = "/home/cua/repo";
const git = (...args) => execFileSync("git", ["-C", REPO, ...args], { encoding: "utf8" }).trim();

function checkout(bundle) {
  writeFileSync("/tmp/repo.bundle", Buffer.from(bundle, "base64"));
  rmSync(REPO, { recursive: true, force: true });
  execFileSync("git", ["-c", "advice.detachedHead=false", "clone", "-q", "/tmp/repo.bundle", REPO]);
  git("remote", "remove", "origin");
  git("checkout", "-q", "-b", "biscotti");
  git("config", "user.name", "biscotti");
  git("config", "user.email", "biscotti@users.noreply.github.com");
  return git("rev-parse", "HEAD");
}

// jj alongside git in the checkout. It has no remote, so trunk() would be the root: diffs are against `base`, the
// commit it started from.
function colocate(base) {
  const env = { ...process.env, HOME };
  const who = ["--config", "user.name=biscotti", "--config", "user.email=biscotti@users.noreply.github.com"];
  execFileSync("jj", [...who, "git", "init", "--colocate", REPO], { stdio: "ignore", env });
  execFileSync("jj", ["-R", REPO, "config", "set", "--repo", 'revset-aliases."trunk()"', base], { stdio: "ignore", env });
  execFileSync("jj", ["-R", REPO, "config", "set", "--repo", "user.name", "biscotti"], { stdio: "ignore", env });
  execFileSync("jj", ["-R", REPO, "config", "set", "--repo", "user.email", "biscotti@users.noreply.github.com"], { stdio: "ignore", env });
}

// Authorize the key, check out the repo, run setup; each optional. Answers {type: "box", ok}.
async function setUpBox({ key, repo, setup }, socket) {
  const say = (event) => !socket.destroyed && socket.write(`${JSON.stringify(event)}\n`);
  try {
    // Every VM starts from the same image and snapshot, so the box makes its own host keys the first time it's set up
    // (they live on its work disk, so a kept box keeps them) and sshd reloads them.
    // (As root: this agent runs as cua, which has sudo.)
    if (!existsSync("/etc/ssh/biscotti-box")) {
      const script = "rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub && ssh-keygen -A && touch /etc/ssh/biscotti-box && pkill -HUP -x sshd";
      execFileSync("sudo", ["-n", "sh", "-c", script], { stdio: "ignore" });
      // Answer once sshd serves the new key, so the owner's first ssh sees the key the box reports.
      const pub = readFileSync("/etc/ssh/ssh_host_ed25519_key.pub", "utf8").split(" ")[1];
      for (let i = 0; i < 50; i++) {
        try {
          if (execFileSync("ssh-keyscan", ["-t", "ed25519", "127.0.0.1"], { stdio: ["ignore", "pipe", "ignore"], timeout: 2000 }).toString().includes(pub)) break;
        } catch {}
        await new Promise((r) => setTimeout(r, 100));
      }
    }
    if (key) {
      mkdirSync(`${HOME}/.ssh`, { recursive: true, mode: 0o700 });
      // Each of the owner's devices adds its key.
      const keys = existsSync(`${HOME}/.ssh/authorized_keys`) ? readFileSync(`${HOME}/.ssh/authorized_keys`, "utf8").split("\n").filter(Boolean) : [];
      writeFileSync(`${HOME}/.ssh/authorized_keys`, `${[...new Set([...keys, key.trim()])].join("\n")}\n`, { mode: 0o600 });
      execFileSync("chown", ["-R", "cua:cua", `${HOME}/.ssh`]);
    }
    if (repo) {
      colocate(checkout(repo));
    }
    if (setup) {
      const child = spawn("bash", ["-lc", setup], { cwd: existsSync(REPO) ? REPO : HOME, stdio: ["ignore", "pipe", "pipe"] });
      for (const stream of [child.stdout, child.stderr]) createInterface({ input: stream }).on("line", (line) => say({ type: "setup", line }));
      const [code] = await once(child, "close");
      if (code !== 0) throw new Error(`the setup command (${setup}) exited with ${code}`);
    }
    execFileSync("chown", ["-R", "cua:cua", HOME]);
    say({ type: "box", ok: true, hostKey: readFileSync("/etc/ssh/ssh_host_ed25519_key.pub", "utf8").trim().split(" ").slice(0, 2).join(" ") });
  } catch (err) {
    say({ type: "box", ok: false, error: err.message });
  }
  socket.end();
}

createServer({ allowHalfOpen: true }, (socket) => {
  let body = "";
  socket.setEncoding("utf8").on("data", (d) => (body += d));
  socket.on("error", () => {});
  socket.on("end", () => {
    // A readiness probe connects and sends nothing.
    if (!body.trim()) return socket.end();
    const asked = JSON.parse(body);
    if (asked.box) return void setUpBox(asked.box, socket);
    socket.end(`${JSON.stringify({ type: "box", ok: false, error: "only setup is asked of this VM" })}\n`);
  });
}).listen(4000, "0.0.0.0");
