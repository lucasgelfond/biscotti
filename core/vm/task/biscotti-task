#!/usr/bin/env node
// The VM's task agent: pi, started at boot and waiting in RPC mode, so the snapshot holds it loaded and a restored VM
// starts on a task at once. One task per VM: the goal arrives on port 4000, pi's JSON events go back, then a
// screenshot of the final screen.
import { execFileSync, spawn } from "node:child_process";
import { existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { createServer } from "node:net";

const PROMPT = `You are a task agent in a disposable Debian VM with internet access. Chromium is open on the desktop (DISPLAY=:1; sudo works); the requester may be watching it live.

Tools:
- Websites: the browser tools drive that Chromium. Work from browser_snapshot (the page's accessibility tree with element refs): click, type and select by ref. That is faster and more reliable than pixels. Actions don't return the page, so take a snapshot (or a screenshot) when you need to see it, e.g. after a group of actions.
- Seeing: take a screenshot (the desktop tools, or browser_take_screenshot) whenever the layout matters: seat maps, charts, canvases, images, anything the snapshot doesn't explain, and to check a result. Look at it before deciding.
- Other apps and the shell: the desktop tools (typing and key presses need delivery_mode foreground) and bash.
- The biscotti tools: share_screenshot texts the requester what's on screen now, with a caption (use it for each thing they asked to see: listings, options, a seat map); web search; and the owner's vault. For logins and cards, vault_list, click the first input (by ref), then vault_fill: it types the saved values itself, so you never see them (each waits for the owner's approval). To reset a password or make an account, click the new-password input and call vault_new_password (confirm: true when there's a confirm box): it makes the password, types it and saves it. Never make up, type or report a password yourself.

How to work:
- Decide what done looks like (e.g. "the confirmation page shows an order number"), then work toward it in short groups of actions: fill a whole form, then check once.
- After each group, check that it worked (a fresh snapshot or a screenshot). If it didn't, say in a sentence why, and try a different way rather than repeating the same action. Dropdowns and date pickers: try keyboard or select by ref.
- Stay in one tab unless a site opens another. Close popups and cookie banners first.
- Before paying, booking or sending anything the goal didn't clearly ask for, stop and report instead.
- Seat maps, charts and other drawn things (canvas, SVG, images): once the map is up, take one screenshot (browser_take_screenshot) and describe it from that image: which sections are open, roughly how full, and the best seats left. Don't inspect the page's code to read it, and don't select seats unless the goal asks.
- If the site doesn't list what the goal asks for (a film not playing there, a product not sold), say so in the report right away rather than searching around for it.
- Be quick: the requester is waiting on a text. Aim to finish in about 3 minutes. If a site blocks you (a bot check, a login wall) or the same approach fails twice, stop and report what you found and what blocked you.

End with a short report of what you did and found, with the facts the requester needs (prices, times, confirmation numbers) and the URL of the page you ended on. Leave the relevant view on screen: the report and a screenshot of the final screen are all the requester sees.`;

// The desktop tools' token appears once cua-spacesd is up; Chromium answers on its debugging port.
while (!existsSync("/run/cua/env-token")) await new Promise((r) => setTimeout(r, 100));
while (!(await fetch("http://127.0.0.1:9222/json/version").then((r) => r.ok, () => false))) await new Promise((r) => setTimeout(r, 100));

const pi = spawn("pi", ["--mode", "rpc", "--no-session", "--model", "biscotti/task", "--append-system-prompt", PROMPT], {
  stdio: ["pipe", "pipe", "inherit"],
});
const send = (command) => pi.stdin.write(`${JSON.stringify(command)}\n`);

// pi's stdout as JSON records, split on LF only.
const listeners = new Set();
let buffer = "";
pi.stdout.setEncoding("utf8").on("data", (chunk) => {
  buffer += chunk;
  for (let i = buffer.indexOf("\n"); i >= 0; i = buffer.indexOf("\n")) {
    const line = buffer.slice(0, i);
    buffer = buffer.slice(i + 1);
    if (line.trim()) for (const listener of listeners) listener(line, JSON.parse(line));
  }
});

// A coding task's repo arrives as a git bundle: checked out in ~/repo on its own branch with no remote (nothing in the
// VM can push), and the commits made on it go back as a bundle for the host to review and open as a pull request.
const REPO = "/home/cua/repo";
const git = (...args) => execFileSync("git", ["-C", REPO, ...args], { encoding: "utf8" }).trim();
const CODING = `This is a coding task. The repository is checked out in ~/repo on a branch of its own, with no remote: you can't push, and don't try. Work there: read the code, make the change, run its tests or build if it has them (git, node, npm and pnpm are installed), and commit your work with clear messages. Never merge, rebase onto other branches or rewrite existing commits. Your commits become a draft pull request the owner reviews; nothing is merged. Take the time the change needs: the 3-minute guideline is for browsing. End with a short summary of what changed and how you checked it.

The goal: `;

function checkout(bundle) {
  writeFileSync("/tmp/repo.bundle", Buffer.from(bundle, "base64"));
  rmSync(REPO, { recursive: true, force: true });
  execFileSync("git", ["-c", "advice.detachedHead=false", "clone", "-q", "/tmp/repo.bundle", REPO]);
  git("remote", "remove", "origin");
  git("checkout", "-q", "-b", "biscotti");
  git("config", "user.name", "biscotti");
  git("config", "user.email", "biscotti@users.noreply.github.com");
  return git("rev-parse", "HEAD");
}

// The commits since `base`, with anything left uncommitted committed first.
function commits(base) {
  git("add", "-A");
  if (git("status", "--porcelain")) git("commit", "-q", "-m", "Uncommitted changes at the end of the task");
  if (git("rev-parse", "HEAD") === base) return undefined;
  execFileSync("git", ["-C", REPO, "bundle", "create", "-q", "/tmp/out.bundle", `${base}..HEAD`]);
  return readFileSync("/tmp/out.bundle").toString("base64");
}

// Ready once pi answers.
await new Promise((resolve) => {
  const ready = (_, record) => record.id === "ready" && (listeners.delete(ready), resolve());
  listeners.add(ready);
  send({ id: "ready", type: "get_state" });
});

// A plugin's own task runner instead of pi: its files run with node, the goal on stdin, and its last stdout line is the
// report.
function runOwn(task, socket) {
  const dir = "/tmp/runner";
  rmSync(dir, { recursive: true, force: true });
  mkdirSync(dir);
  for (const [name, source] of Object.entries(task.runner)) writeFileSync(`${dir}/${name.replace(/[^\w.-]/g, "")}`, source);
  const child = spawn("node", [`${dir}/main.ts`], { stdio: ["pipe", "pipe", "inherit"] });
  let out = "";
  child.stdout.setEncoding("utf8").on("data", (d) => (out += d));
  child.stdin.end(task.goal);
  child.on("close", () => {
    const report = out.trim().split("\n").at(-1) || "The runner ended without a report.";
    socket.write(`${JSON.stringify({ type: "message_end", message: { role: "assistant", content: [{ type: "text", text: report }] } })}\n`);
    screenshot(socket);
    socket.end();
  });
}

function screenshot(socket) {
  try {
    execFileSync("scrot", ["-o", "/tmp/screen.png"], { env: { ...process.env, DISPLAY: ":1" } });
    const png = execFileSync("base64", ["-w0", "/tmp/screen.png"], { encoding: "utf8" });
    socket.write(`${JSON.stringify({ type: "screenshot", png })}\n`);
  } catch {}
}

createServer({ allowHalfOpen: true }, (socket) => {
  let goal = "";
  socket.setEncoding("utf8").on("data", (d) => (goal += d));
  socket.on("error", () => {});
  socket.on("end", () => {
    // A readiness probe connects and sends nothing.
    if (!goal.trim()) return socket.end();
    const task = JSON.parse(goal);
    if (task.runner) return runOwn(task, socket);
    let base;
    try {
      if (task.repo) base = checkout(task.repo);
    } catch (err) {
      socket.write(`${JSON.stringify({ type: "message_end", message: { role: "assistant", content: [{ type: "text", text: `Couldn't check out the repo: ${err.message}` }] } })}\n`);
      return socket.end();
    }
    const forward = (line, record) => {
      if (record.type !== "response") socket.write(`${line}\n`);
      if (record.type !== "agent_settled") return;
      listeners.delete(forward);
      if (base) {
        try {
          const data = commits(base);
          if (data) socket.write(`${JSON.stringify({ type: "bundle", data })}\n`);
        } catch (err) {
          socket.write(`${JSON.stringify({ type: "message_end", message: { role: "assistant", content: [{ type: "text", text: `Couldn't bundle the commits: ${err.message}` }] } })}\n`);
        }
      }
      screenshot(socket);
      socket.end();
    };
    listeners.add(forward);
    send({ type: "prompt", message: base ? CODING + task.goal : task.goal });
  });
}).listen(4000, "0.0.0.0");
