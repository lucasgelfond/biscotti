# The settings in /var/lib/biscotti/.env (chmod 600), which the installer app pre-fills and first boot completes.
# Never commit the real file.
AI_GATEWAY_API_KEY=
# The models, as AI Gateway ids: MODEL for the main agent, TASK_MODEL for task VMs.
MODEL=deepseek/deepseek-v4.1-flash-1017-fast
TASK_MODEL=deepseek/deepseek-v4.1-flash-1017-fast
TZ=America/New_York
# channels/spectrum: from the Photon dashboard, and the only sender biscotti answers (e.g. +15551234567)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
OWNER=
# exa: https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# connectors/executor: your login for Executor's admin account (the password is generated on first boot)
OWNER_EMAIL=
# Generated on first boot: EXECUTOR_ADMIN_PASSWORD, SECRETS_KEY, TAILNET_HOST, FIRECRACKER_BIN
